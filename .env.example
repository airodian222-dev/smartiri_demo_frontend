# Used by the dev server / `vite preview` proxy when the console is configured
# with empty (same-origin) URLs.
# chirpstack-rest-api (REST gateway, default port 8090)
CHIRPSTACK_REST_URL=http://localhost:8090
# ChirpStack server, serves gRPC-web (default port 8080)
CHIRPSTACK_GRPC_URL=http://localhost:8080
